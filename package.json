{
  "name": "create-mission",
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first, agent-native mission control for solo products — goal, gates, evidence-only metrics, stall detection.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mission": "tsx mission/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild mission/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cli.mjs",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "bin": {
    "create-mission": "bin/create-mission.mjs"
  },
  "files": [
    "dist",
    "bin",
    "mission/mission.json",
    "docs/method.md",
    "docs/journal.md",
    ".claude/skills/mission/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivan629/mission.git"
  },
  "homepage": "https://github.com/ivan629/mission#readme",
  "keywords": [
    "mission-control",
    "goals",
    "accountability",
    "solo-dev",
    "indie-hacker",
    "claude-code",
    "agent",
    "local-first",
    "build-in-public"
  ]
}
