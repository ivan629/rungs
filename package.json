{
  "name": "create-rungs",
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first, agent-native launch tracker for solo products — one goal, the gates to it, evidence-only metrics, stall detection.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "rungs": "tsx rungs/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild rungs/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cli.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "bin": {
    "create-rungs": "bin/create-rungs.mjs"
  },
  "files": [
    "dist",
    "bin",
    "rungs/mission.json",
    "docs/method.md",
    "docs/journal.md",
    ".claude/skills/rungs/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivan629/rungs.git"
  },
  "homepage": "https://github.com/ivan629/rungs#readme",
  "keywords": [
    "rungs",
    "launch-tracker",
    "goals",
    "accountability",
    "solo-dev",
    "indie-hacker",
    "claude-code",
    "agent",
    "local-first",
    "build-in-public"
  ]
}
